nt="1"><mxGeometry x="60.0" y="658.0" width="1480.0" height="240.0" as="geometry"/></mxCell><mxCell id="c51" value="The trading engine: every order follows the same four steps" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontSize=19;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="60.0" y="674.3" width="1480.0" height="26.8" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2D8C6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="84.0" y="714.0" width="328.0" height="160.0" as="geometry"/></mxCell><mxCell id="c53" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#A6192E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=17;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="103.0" y="733.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c54" value="Check it" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="148.0" y="739.3" width="200.0" height="26.8" as="geometry"/></mxCell><mxCell id="c55" value='&lt;div style="line-height:23px"&gt;Is there enough cash or shares? Is the market open right now? If yes, the order is locked in.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="108.0" y="783.3" width="282.0" height="73.0" as="geometry"/></mxCell><mxCell id="c56" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2D8C6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="452.0" y="714.0" width="328.0" height="160.0" as="geometry"/></mxCell><mxCell id="c57" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#A6192E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=17;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="471.0" y="733.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c58" value="Price it" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="516.0" y="739.3" width="200.0" height="26.8" as="geometry"/></mxCell><mxCell id="c59" value='&lt;div style="line-height:23px"&gt;Uses the live market price at that exact moment. Out-of-date prices are refused, never guessed.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="476.0" y="783.3" width="282.0" height="73.0" as="geometry"/></mxCell><mxCell id="c60" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2D8C6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820.0" y="714.0" width="328.0" height="160.0" as="geometry"/></mxCell><mxCell id="c61" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#A6192E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=17;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="839.0" y="733.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c62" value="Complete the trade" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="884.0" y="739.3" width="200.0" height="26.8" as="geometry"/></mxCell><mxCell id="c63" value='&lt;div style="line-height:23px"&gt;Holdings, cash and the permanent record update together: all or nothing, even if a system fails.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="844.0" y="783.3" width="282.0" height="73.0" as="geometry"/></mxCell><mxCell id="c64" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2D8C6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1188.0" y="714.0" width="328.0" height="160.0" as="geometry"/></mxCell><mxCell id="c65" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#A6192E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=17;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1207.0" y="733.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c66" value="Show the result" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1252.0" y="739.3" width="200.0" height="26.8" as="geometry"/></mxCell><mxCell id="c67" value='&lt;div style="line-height:23px"&gt;The client&amp;#x27;s screen updates within moments, with no refresh. Filled or rejected, explained in plain words.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1212.0" y="783.3" width="282.0" height="73.0" as="geometry"/></mxCell><mxCell id="e68" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#A6192E;strokeWidth=2.5;jettySize=auto;orthogonalLoop=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e69" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#A6192E;strokeWidth=2.5;jettySize=auto;orthogonalLoop=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e70" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#A6192E;strokeWidth=2.5;jettySize=auto;orthogonalLoop=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c60" target="c64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e71" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#A6192E;strokeWidth=2.5;jettySize=auto;orthogonalLoop=1;exitX=0.2000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="Order sent" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#A6192E;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="260.0" y="599.6" width="120.0" height="19.6" as="geometry"/></mxCell><mxCell id="e73" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#A6192E;strokeWidth=2.5;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=7 6;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5784;entryDx=0;entryDy=0;" edge="1" parent="1" source="c64" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1352.0" y="612.0"/><mxPoint x="1040.0" y="612.0"/><mxPoint x="1040.0" y="486.0"/></Array></mxGeometry></mxCell><mxCell id="c74" value="Result, balance and history update on the client&amp;#x27;s screen" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#A6192E;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1056.0" y="590.6" width="460.0" height="19.6" as="geometry"/></mxCell><mxCell id="e75" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#A6192E;strokeWidth=2.5;jettySize=auto;orthogonalLoop=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3176;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e76" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#B8890F;strokeWidth=2.5;jettySize=auto;orthogonalLoop=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8446;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geomet