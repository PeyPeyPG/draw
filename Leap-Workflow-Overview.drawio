tps%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="108.0" y="1023.3" width="282.0" height="73.0" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2D8C6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="452.0" y="954.0" width="328.0" height="150.0" as="geometry"/></mxCell><mxCell id="c84" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="472.0" y="972.0" width="40.0" height="40.0" as="geometry"/></mxCell><mxCell id="c85" value="Live market prices" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="520.0" y="981.2" width="200.0" height="25.6" as="geometry"/></mxCell><mxCell id="c86" value='&lt;div style="line-height:23px"&gt;Stocks in the UK, US and India, currencies and crypto, from trusted market-data providers.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="476.0" y="1023.3" width="282.0" height="73.0" as="geometry"/></mxCell><mxCell id="c87" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#FBECEC;strokeColor=#A6192E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820.0" y="954.0" width="328.0" height="150.0" as="geometry"/></mxCell><mxCell id="c88" value="Permanent trade record" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontSize=18;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="820.0" y="1013.2" width="328.0" height="25.6" as="geometry"/></mxCell><mxCell id="c89" value='&lt;div style="line-height:21px"&gt;Every order and trade, kept for good and never altered.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="840.0" y="1040.3" width="288.0" height="46.0" as="geometry"/></mxCell><mxCell id="c90" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2D8C6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1188.0" y="954.0" width="328.0" height="150.0" as="geometry"/></mxCell><mxCell id="c91" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1208.0" y="972.0" width="40.0" height="40.0" as="geometry"/></mxCell><mxCell id="c92" value="Reporting copy" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1256.0" y="981.2" width="200.0" height="25.6" as="geometry"/></mxCell><mxCell id="c93" value='&lt;div style="line-height:23px"&gt;A separate copy of the records for analysis, so business reports never slow down client trading.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1212.0" y="1023.3" width="2