c126" value="Balances are always right," style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#14213D;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="310.0" y="1230.9" width="261.5" height="23.2" as="geometry"/></mxCell><mxCell id="c127" value="even after an outage" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#3D4A5C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="310.0" y="1254.8" width="261.5" height="22.0" as="geometry"/></mxCell><mxCell id="c128" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="582.5" y="1239.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c129" value="No trade is ever lost" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#14213D;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="621.5" y="1230.9" width="261.5" height="23.2" as="geometry"/></mxCell><mxCell id="c130" value="or counted twice" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#3D4A5C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="621.5" y="1254.8" width="261.5" height="22.0" as="geometry"/></mxCell><mxCell id="c131" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="894.0" y="1239.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c132" value="Every trade can be traced" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#14213D;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="933.0" y="1230.9" width="261.5" height="23.2" as="geometry"/></mxCell><mxCell id="c133" value="from order to outcome" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#3D4A5C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="933.0" y="1254.8" width="261.5" height="22.0" as="geometry"/></mxCell><mxCell id="c134" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1205.5" y="1239.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c135" value="Clients only ever see" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#14213D;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1244.5" y="1230.9" width="261.5" height="23.2" as="geometry"/></mxCell><mxCell id="c136" value="their own account" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#3D4A5C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1244.5" y="1254.8" width="261.5" height="22.0" as="geometry"/></mxCell><mxCell id="c137" value="Leap direct trading platform · Workflow overview for stakeholder review · October 2026 · BR tags refer to Leap-BRS-2026-014" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;vertic