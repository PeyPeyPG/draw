idth="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c105" value="No trade is ever lost" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="621.5" y="1168.9" width="261.5" height="23.2" as="geometry"/></mxCell><mxCell id="c106" value="or counted twice" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="621.5" y="1192.8" width="261.5" height="22.0" as="geometry"/></mxCell><mxCell id="c107" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="894.0" y="1177.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c108" value="Every trade can be traced" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="933.0" y="1168.9" width="261.5" height="23.2" as="geometry"/></mxCell><mxCell id="c109" value="from order to outcome" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="933.0" y="1192.8" width="261.5" height="22.0" as="geometry"/></mxCell><mxCell id="c110" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1205.5" y="1177.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c111" value="Clients only ever see" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#241C1A;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1244.5" y="1168.9" width="261.5" height="23.2" as="geometry"/></mxCell><mxCell id="c112" value="their own account" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#4A403C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1244.5" y="1192.8" width="261.5" height="22.0" as="geometry"/></mxCell><mxCell id="c113" value="Leap direct trading platform · Workflow overview for stakeholder review · October 2026" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#7A6D64;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="60.0" y="1257.6" width="1300.0" height="19.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>