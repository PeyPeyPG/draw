llColor=#EEF1F5;strokeColor=none;fontColor=#6B7686;fontStyle=1;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="292.0" y="802.0" width="49.0" height="21.0" as="geometry"/></mxCell><mxCell id="c73" value='&lt;div style="line-height:23px"&gt;Is there enough cash or shares? Is the market open right now? If yes, the order is locked in.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#3D4A5C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="108.0" y="845.3" width="282.0" height="73.0" as="geometry"/></mxCell><mxCell id="c74" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD3DD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="452.0" y="776.0" width="328.0" height="160.0" as="geometry"/></mxCell><mxCell id="c75" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0E7C6B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=17;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="471.0" y="795.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c76" value="Price it" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#14213D;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="516.0" y="801.3" width="200.0" height="26.8" as="geometry"/></mxCell><mxCell id="c77" value="BR-08" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=none;fontColor=#6B7686;fontStyle=1;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="715.0" y="802.0" width="49.0" height="21.0" as="geometry"/></mxCell><mxCell id="c78" value='&lt;div style="line-height:23px"&gt;Uses the live market price at that exact moment. Out-of-date prices are refused, never guessed.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#3D4A5C;fontStyle=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="476.0" y="845.3" width="282.0" height="73.0" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD3DD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820.0" y="776.0" width="328.0" height="160.0" as="geometry"/></mxCell><mxCell id="c80" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0E7C6B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=17;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="839.0" y="795.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c81" value="Complete the trade" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#14213D;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="884.0" y="801.3" width="200.0" height="26.8" as="geometry"/></mxCell><mxCell id="c82" value="BR-09" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=none;fontColor=#6B7686;fontStyle=1;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1083.0" y="802.0" width="49.0" height="21.0" as="geometry"/></mxCell><mxCell id="c83" value='&lt;div style="line-height:23px"&gt;Holdings, cash and the permanent 